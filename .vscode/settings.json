{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python-envs.workspaceSearchPaths": [
    ".venv"
  ],
  "python-envs.terminal.autoActivationType": "command",
  "jupyter.askForKernelRestart": false,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true
  },
  "search.exclude": {
    ".venv": true,
    "uv.lock": true
  }
}
